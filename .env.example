# Copy this file to .env before running `docker compose up`.

# Must match `production.database` in roundtable_server/config/passwords.yaml
# (that file is gitignored; it's created locally by `serverpod start` /
# `serverpod generate`). Used to set the Postgres container's password so it
# matches what the server image already has baked in.
ROUNDTABLE_DB_PASSWORD=
